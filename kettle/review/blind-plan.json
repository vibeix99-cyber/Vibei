{
 "_doc": "Blind-review plan: how to capture each Kettle screen and which Duolingo refs (paths under review/refs/duolingo/) it is compared with. `kind` is the neutral screen description shown to the judge. Steps: {eval: js-expression} | {button: 'regex'} (click first visible enabled button whose accessible name matches, case-insensitive) | {click: 'playwright selector'} | {press: 'Key'} | {fill: 'selector', text} | {wait: ms}. Add `optional: true` to tolerate a missing control. Captures run at 390x844 @2x, no full-page, so they match phone screenshots.",
 "viewport": {
  "width": 390,
  "height": 844,
  "deviceScaleFactor": 2,
  "isMobile": true,
  "hasTouch": true
 },
 "screens": [
  {
   "id": "onboarding-question",
   "kind": "onboarding: one question per screen (choose a daily goal / what to learn)",
   "capture": {
    "route": "/welcome",
    "params": {
     "seed": "fresh",
     "onboarded": "0"
    },
    "steps": [
     {
      "button": "^get started"
     },
     {
      "wait": 700
     },
     {
      "fill": "input",
      "text": "Robin"
     },
     {
      "button": "^continue\\b"
     },
     {
      "wait": 1500
     }
    ]
   },
   "refs": [
